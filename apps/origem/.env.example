DATABASE_URL="postgresql://salink:salink@localhost:5433/salink?schema=public"
DIRECT_URL="postgresql://salink:salink@localhost:5433/salink?schema=public"
# Em produção (1 Supabase, schema origem):
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=origem"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres?schema=origem"

# ——— Demo público ———
# 1 = sem login, amostra ~10% dos dados, botão "Experimentar demo" na landing.
# Em produção de demonstração: ORIGEM_DEMO=1 e ORIGEM_DEV_OPEN=0.
ORIGEM_DEMO="0"
# Opcional no client (mesma flag; use se precisar ler no browser)
# NEXT_PUBLIC_ORIGEM_DEMO="1"

# ——— Auth ———
# 1 = app aberto em local (sem login). Em produção / teste: 0
# Login e 2FA ficam no MAX Cultural (AUTH_2FA_DISABLED no hub).
ORIGEM_DEV_OPEN="0"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SSO do hub (mesmo AUTH_SECRET do Cultural). Login só no MAX Cultural.
AUTH_SECRET="gere-um-secret-longo-aleatorio"
NEXT_PUBLIC_CULTURAL_URL="http://localhost:3000"
NEXT_PUBLIC_FLUXO_URL="http://localhost:3002"
# Produção / teste com SSO: .maxcultural.com.br
AUTH_COOKIE_DOMAIN=""
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
# SYNC_INTERNAL_SECRET=""
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
ADMIN_EMAILS="voce@henriquerotsen.com.br"

# ——— Contato (Resend) ———
RESEND_API_KEY=""
CONTACT_TO_EMAIL="contato@henriquerotsen.com.br"
# CONTACT_FROM_EMAIL="Salink <onboarding@resend.dev>"

# Obrigatória: criptografa login e senha SALIC em repouso (AES-256-GCM).
# Em produção use um segredo longo e aleatório; sem ela o app não grava credenciais.
CREDENTIALS_SECRET="change-me-to-a-long-random-string"

# Concorrência de chamadas à API SALIC (2–8). Sync manual: 4 é ok.
# No Vercel / muitos clientes, prefira 2–3.
SYNC_CONCURRENCY="2"

# full = um processo com cache cross-PRONAC (melhor no notebook/worker)
# chunked = 1 PRONAC por tick (melhor no Vercel serverless)
# Vazio: full local; chunked automaticamente se VERCEL=1
SYNC_MODE="chunked"
# Embeddings do catálogo de fornecedores (nomic-embed-text via Ollama).
# Sem o Ollama as recomendações de serviços semelhantes ficam vazias.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_EMBED_MODEL="nomic-embed-text"

DATABASE_URL="postgresql://salink:salink@localhost:5433/salink?schema=public"
# Em produção (Supabase): use a connection string do projeto (pooler :6543 + ?pgbouncer=true)
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ——— Demo público ———
# 1 = sem login, amostra ~10% dos dados, botão "Experimentar demo" na landing.
# Em produção de demonstração: SALINK_DEMO=1 e SALINK_DEV_OPEN=0.
SALINK_DEMO="0"
# Opcional no client (mesma flag; use se precisar ler no browser)
# NEXT_PUBLIC_SALINK_DEMO="1"

# ——— Auth (Supabase) ———
# 1 = app aberto em local (sem login). Em produção deixe 0 ou remova.
SALINK_DEV_OPEN="0"
# Sem estas vars (ou com placeholders) o app também roda aberto.
# Em produção configure Auth + URLs e SALINK_DEV_OPEN=0.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SSO do hub (mesmo AUTH_SECRET do Cultural). Login só no MAX Cultural.
AUTH_SECRET="gere-um-secret-longo-aleatorio"
NEXT_PUBLIC_CULTURAL_URL="http://localhost:3000"
AUTH_COOKIE_DOMAIN=""
# Site URL deste app
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
# Service role: só servidor (criar usuários). Nunca exponha no client.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# E-mails que viram ADMIN automaticamente no primeiro login / sync de perfil
ADMIN_EMAILS="voce@henriquerotsen.com.br"
# URL pública do site (links de recuperação de senha) — em prod: https://origem.maxcultural.com.br

# ——— Contato (Resend) ———
RESEND_API_KEY=""
CONTACT_TO_EMAIL="contato@henriquerotsen.com.br"
# CONTACT_FROM_EMAIL="Salink <onboarding@resend.dev>"

# Obrigatória: criptografa login e senha SALIC em repouso (AES-256-GCM).
# Em produção use um segredo longo e aleatório; sem ela o app não grava credenciais.
CREDENTIALS_SECRET="change-me-to-a-long-random-string"

# Concorrência de chamadas à API SALIC (2–8). Sync manual: 4 é ok.
# No Vercel / muitos clientes, prefira 2–3.
SYNC_CONCURRENCY="4"

# full = um processo com cache cross-PRONAC (melhor no notebook/worker)
# chunked = 1 PRONAC por tick (melhor no Vercel serverless)
# Vazio: full local; chunked automaticamente se VERCEL=1
SYNC_MODE=""
# Embeddings do catálogo de fornecedores (nomic-embed-text via Ollama).
# Sem o Ollama as recomendações de serviços semelhantes ficam vazias.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_EMBED_MODEL="nomic-embed-text"

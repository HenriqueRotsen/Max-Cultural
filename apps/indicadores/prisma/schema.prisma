generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Inscricao {
  id                      String   @id @default(cuid())
  contextoId              String?  @map("contexto_id")
  nomeContexto            String   @default("") @map("Nome_contexto")
  idProjeto               String   @map("id_projeto")
  /// Coluna no formato do SIGA (id_oficina): a ação da inscrição.
  idAcao                  String   @map("id_oficina")
  proponente              String   @map("PROPONENTE")
  pronac                  String   @map("PRONAC")
  nomeProjeto             String   @map("Nome_projeto")
  identificacaoAnoProjeto String   @map("Identificacao_ano_projeto")
  nomeAcao                String   @map("Nome_oficina")
  dataInscricao           String   @map("Data_inscricao")
  nome                    String   @map("Nome")
  apelido                 String   @default("") @map("Apelido")
  cpf                     String   @map("CPF")
  dataNascimento          String   @default("") @map("Data_nascimento")
  genero                  String   @default("") @map("Genero")
  etnia                   String   @default("") @map("Etnia")
  email                   String   @default("") @map("E-mail")
  telefone                String   @default("") @map("Telefone")
  possuiDeficiencia       String   @default("Não") @map("Possui_deficiencia")
  restricaoAlimentar      String   @default("") @map("RestricaoAlimentar")
  ficouSabendo            String   @default("") @map("Ficousabendo")
  lougradouro             String   @default("") @map("Lougradouro")
  numero                  String   @default("") @map("Numero")
  complemento             String   @default("") @map("Complemento")
  bairro                  String   @default("") @map("Bairro")
  cep                     String   @default("") @map("CEP")
  cidade                  String   @default("") @map("Cidade")
  estado                  String   @default("") @map("Estado")
  redesocial              String   @default("") @map("Redesocial")
  escolaridade            String   @default("") @map("Escolaridade")
  idadeAtual              Int?     @map("idade_atual")
  idadeInscricao          Int?     @map("idade_inscricao")
  territorio              String   @default("") @map("Territorio")
  inscritos               Int      @default(1) @map("Inscritos")
  selecionados            Int      @default(0) @map("Selecionados")
  /// Derivado da coluna de planilha "Participação":
  /// Certificou → 1 | Participou → 1 | Não Participou → 0
  participantes           Int      @default(0) @map("Participantes")
  /// Derivado da coluna de planilha "Participação":
  /// Certificou → 1 | Participou → 0 | Não Participou → 0
  certificado             Int      @default(0) @map("Certificado")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([contextoId])
  @@index([idProjeto])
  @@index([idAcao])
  @@index([pronac])
  @@index([cpf])
  @@index([estado])
  @@index([cidade])
  @@index([territorio])
  @@map("inscricoes")
}

model Contexto {
  id        String    @id @default(cuid())
  nome      String    @default("")
  projetos  Projeto[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("contextos")
}

model Projeto {
  id         String   @id
  nome       String
  pronac     String
  proponente String   @default("")
  ano        String   @default("")
  contextoId String
  contexto   Contexto @relation(fields: [contextoId], references: [id], onDelete: Restrict)
  acoes      Acao[]
  acompanhamento AcompanhamentoProjeto?
  prestacao      PrestacaoProjeto?
  produtos       PrestacaoProduto[]
  fichas         PrestacaoFicha[]
  relatorios     PrestacaoRelatorio[]
  tarefas        Tarefa[]
  ocorrencias    Ocorrencia[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([contextoId])
  @@index([pronac])
  @@map("projetos")
}

/// Ação do projeto (Contexto → Projeto → Ação). Oficina é um tipo de ação.
model Acao {
  id                 String              @id
  nome               String
  projetoId          String
  projeto            Projeto             @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  tipoId             String              @default("oficina") @map("tipo_id")
  tipo               AcaoTipo            @relation(fields: [tipoId], references: [id], onDelete: Restrict)
  /// Oferece modalidade online (opção sintética "Online" na inscrição).
  ofereceOnline      Boolean             @default(false) @map("oferece_online")
  /// Oferece modalidade presencial (requer ≥1 AcaoTerritorio na UI).
  oferecePresencial  Boolean             @default(true) @map("oferece_presencial")
  territorios        AcaoTerritorio[]
  territorioAliases  AcaoTerritorioAlias[]
  agenda             AcaoAgenda[]
  tarefas            Tarefa[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([projetoId])
  @@index([tipoId])
  @@map("acoes")
}

/// Tipo de ação (Oficina, Apresentação, Exposição…). Editável pela gestão.
model AcaoTipo {
  id        String   @id
  nome      String
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  acoes     Acao[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("acao_tipos")
}

/// Locais presenciais em que a ação ocorre (N por ação).
model AcaoTerritorio {
  id        String                   @id @default(cuid())
  acaoId    String                   @map("acao_id")
  acao      Acao                     @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  /// Rótulo curto da comunidade/território (opcional se for só a cidade).
  nome      String                   @default("")
  cidade    String
  estado    String
  ordem     Int                      @default(0)
  aliases   AcaoTerritorioAlias[]
  agenda    AcaoAgenda[]
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@index([acaoId, ordem])
  @@index([cidade, estado])
  @@map("acao_territorios")
}

/// Alias de texto livre (import) → Online ou um AcaoTerritorio / cidade-UF.
model AcaoTerritorioAlias {
  id                  String             @id @default(cuid())
  acaoId              String             @map("acao_id")
  acao                Acao               @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  rawNormalized       String             @map("raw_normalized")
  online              Boolean            @default(false)
  acaoTerritorioId    String?            @map("acao_territorio_id")
  acaoTerritorio      AcaoTerritorio?    @relation(fields: [acaoTerritorioId], references: [id], onDelete: SetNull)
  cidade              String             @default("")
  estado              String             @default("")
  territorio          String             @default("")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([acaoId, rawNormalized])
  @@index([acaoId])
  @@map("acao_territorio_aliases")
}

enum FormularioTipo {
  INSCRICAO
  AVALIACAO
}

enum FormularioRespostaStatus {
  PENDING
  READY
  MERGED
  REJECTED
}

enum FormularioCampoTipo {
  SECTION
  SHORT_TEXT
  LONG_TEXT
  MULTIPLE_CHOICE
  CHECKBOXES
  DROPDOWN
  FILE_UPLOAD
  DATE
  EMAIL
  CPF
  PHONE_BR
  NAME
  BIRTHDATE
  GENERO
  ETNIA
  SIM_NAO_DETALHE
  ADDRESS_BR
  DECLARACAO
  PARTICIPACAO
  TERRITORIO_ACAO
}

model Formulario {
  id                   String         @id @default(cuid())
  acaoId               String         @map("acao_id")
  titulo               String
  descricao            String         @default("") @db.Text
  slug                 String         @unique
  abreEm               DateTime?      @map("abre_em")
  encerraEm            DateTime?      @map("encerra_em")
  ativo                Boolean        @default(true)
  tipo                 FormularioTipo @default(INSCRICAO)
  capaUrl              String         @default("") @map("capa_url")
  mensagemConfirmacao  String         @default("Inscrição enviada com sucesso. Aguarde o contato da equipe.") @map("mensagem_confirmacao") @db.Text
  createdByUserId      String?        @map("created_by_user_id")
  createdBy            User?          @relation("FormularioCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  campos               FormularioCampo[]
  respostas            FormularioResposta[]

  @@index([acaoId])
  @@index([ativo])
  @@map("formularios")
}

model FormularioCampo {
  id           String              @id @default(cuid())
  formularioId String              @map("formulario_id")
  formulario   Formulario          @relation(fields: [formularioId], references: [id], onDelete: Cascade)
  ordem        Int                 @default(0)
  rotulo       String
  descricao    String              @default("") @db.Text
  obrigatorio  Boolean             @default(false)
  tipo         FormularioCampoTipo
  /// Coluna SIGA (ex.: "E-mail") ou null = pergunta extra
  sigaColumn   String?             @map("siga_column")
  opcoes       Json?
  config       Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([formularioId, ordem])
  @@map("formulario_campos")
}

model FormularioResposta {
  id                String                   @id @default(cuid())
  formularioId      String                   @map("formulario_id")
  formulario        Formulario               @relation(fields: [formularioId], references: [id], onDelete: Cascade)
  cpf               String
  payload           Json
  status            FormularioRespostaStatus @default(PENDING)
  selecionados      Int                      @default(0)
  participantes     Int                      @default(0)
  certificado       Int                      @default(0)
  /// Nome do professor que se atribuiu à resposta (checkbox na fila).
  professorNome     String                   @default("") @map("professor_nome")
  mergedInscricaoId String?                  @map("merged_inscricao_id")
  reviewedByUserId  String?                  @map("reviewed_by_user_id")
  reviewedAt        DateTime?                @map("reviewed_at")
  submittedAt       DateTime                 @default(now()) @map("submitted_at")
  updatedAt         DateTime                 @updatedAt

  @@unique([formularioId, cpf])
  @@index([formularioId, status])
  @@index([cpf])
  @@map("formulario_respostas")
}

/// Responsável pela ação (na oficina, o professor).
model AcaoResponsavel {
  id        String   @id @default(cuid())
  acaoId    String   @map("acao_id")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([acaoId, userId])
  @@index([userId])
  @@index([acaoId])
  @@map("acao_responsaveis")
}

/// Modelos reutilizáveis (inscrição / avaliação) editáveis no dashboard.
model FormularioModelo {
  id                  String         @id @default(cuid())
  tipo                FormularioTipo @unique
  nome                String
  tituloDefault       String         @default("") @map("titulo_default")
  descricaoDefault    String         @default("") @map("descricao_default") @db.Text
  mensagemConfirmacao String         @default("") @map("mensagem_confirmacao") @db.Text
  capaUrlDefault      String         @default("") @map("capa_url_default")
  campos              Json
  updatedAt           DateTime       @updatedAt
  createdAt           DateTime       @default(now())

  @@map("formulario_modelos")
}

model GeoCache {
  id          String   @id @default(cuid())
  key         String   @unique
  cidade      String
  estado      String
  lat         Float
  lng         Float
  displayName String   @default("")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([estado])
  @@map("geo_cache")
}

enum DataScopeMode {
  ALL
  LIMITED
}

enum PermissionEffect {
  GRANT
  DENY
}

enum DataScopeKind {
  CONTEXTO
  PROJETO
  ACAO
}

/** Nível de acesso no recurso. NONE = bloqueio explícito sob ancestral liberado. */
enum DataScopeAccess {
  NONE
  VIEWER
  EDITOR
}

enum EmailOtpPurpose {
  LOGIN_2FA
}

model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  name               String
  passwordHash       String
  roleId             String
  role               Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  /** Acesso privilegiado fora do catálogo de papéis (bootstrap). */
  isSuperAdmin       Boolean       @default(false)
  dataScopeMode      DataScopeMode @default(LIMITED)
  mustChangePassword Boolean       @default(true)
  totpSecretEnc      String?
  totpEnabled        Boolean       @default(false)
  sessionVersion     Int           @default(1)
  deactivatedAt      DateTime?
  lastLoginAt        DateTime?
  createdById        String?
  createdBy          User?         @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers       User[]        @relation("UserCreatedBy")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  permissions      UserPermission[]
  dataScopes       UserDataScope[]
  sessions         AuthSession[]
  passwordResets   PasswordResetToken[]
  emailOtps        EmailOtp[]
  auditLogs        AuditLog[]           @relation("AuditActor")
  formulariosCriados Formulario[]       @relation("FormularioCreatedBy")
  acoesResponsavel   AcaoResponsavel[]

  @@index([roleId])
  @@index([deactivatedAt])
  @@map("users")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  label       String
  group       String
  description String   @default("")
  createdAt   DateTime @default(now())

  roles RolePermission[]
  users UserPermission[]

  @@map("permissions")
}

model Role {
  id            String        @id @default(cuid())
  name          String        @unique
  description   String        @default("")
  isSystem      Boolean       @default(false)
  /** Escopo padrão de dados para usuários deste papel (se o usuário não tiver escopo próprio). */
  dataScopeMode DataScopeMode @default(LIMITED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  permissions RolePermission[]
  dataScopes  RoleDataScope[]
  users       User[]

  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RoleDataScope {
  id         String          @id @default(cuid())
  roleId     String
  kind       DataScopeKind
  resourceId String
  access     DataScopeAccess @default(VIEWER)
  role       Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@unique([roleId, kind, resourceId])
  @@index([roleId])
  @@map("role_data_scopes")
}

model UserPermission {
  userId       String
  permissionId String
  effect       PermissionEffect
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

model UserDataScope {
  id         String          @id @default(cuid())
  userId     String
  kind       DataScopeKind
  resourceId String
  access     DataScopeAccess @default(VIEWER)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@unique([userId, kind, resourceId])
  @@index([userId])
  @@map("user_data_scopes")
}

model AuthSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailOtp {
  id        String         @id @default(cuid())
  userId    String
  purpose   EmailOtpPurpose
  codeHash  String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("email_otps")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorUserId String?
  actor      User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action     String
  entityType String   @default("")
  entityId   String   @default("")
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ——— Acompanhamento: Comunicação e Produção ———

enum AreaTarefa {
  COMUNICACAO
  PRODUCAO
}

/// Nível 1 (projeto): PLANEJAMENTO → ESTRUTURACAO → FLUXO_CONTINUO → ENCERRAMENTO.
/// Nível 2 (ação/cidade): ANTES → DURANTE → DEPOIS.
enum FaseTarefa {
  PLANEJAMENTO
  ESTRUTURACAO
  FLUXO_CONTINUO
  ENCERRAMENTO
  ANTES
  DURANTE
  DEPOIS
}

/// A quem a tarefa se aplica: o projeto, cada realização da ação (data) ou cada cidade.
enum UnidadeTarefa {
  PROJETO
  ACAO
  CIDADE
}

/// Data de referência do prazo (prazoDias é somado a ela).
enum PrazoBase {
  INICIO_EXECUCAO
  FIM_EXECUCAO
  INICIO_ACAO
  FIM_ACAO
}

enum StatusTarefa {
  NAO_CONTEMPLADA
  NAO_INICIADA
  EM_ANDAMENTO
  CONCLUIDA
}

enum ImpactoOcorrencia {
  BAIXO
  MEDIO
  ALTO
}

enum StatusOcorrencia {
  ABERTA
  RESOLVIDA
}

/// Padrão de tarefas (editável). Cada projeto recebe cópias em `Tarefa`.
model TarefaModelo {
  id           String         @id @default(cuid())
  area         AreaTarefa
  nivel        Int
  fase         FaseTarefa
  titulo       String
  detalhamento String         @default("")
  unidade      UnidadeTarefa
  /// Prazo: data base + dias (D±N; negativo = antes). Nulo = sem prazo.
  prazoBase    PrazoBase?     @map("prazo_base")
  prazoDias    Int?           @map("prazo_dias")
  /// Tipos de ação a que se aplica (ids de acao_tipos). Vazio = todos.
  tiposAcao    String[]       @default([]) @map("tipos_acao")
  ordem        Int            @default(0)
  ativo        Boolean        @default(true)
  tarefas      Tarefa[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([area, nivel, ordem])
  @@map("tarefa_modelos")
}

/// Datas e situação do projeto para o acompanhamento (1 por projeto).
model AcompanhamentoProjeto {
  id                  String    @id @default(cuid())
  projetoId           String    @unique @map("projeto_id")
  projeto             Projeto   @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  inicioExecucao      DateTime? @map("inicio_execucao")
  fimExecucao         DateTime? @map("fim_execucao")
  /// Detectado no Financeiro (captadoTransferido > 0) ou informado pela gestão. Antes disso as tarefas aguardam.
  recursoLiberadoEm   DateTime? @map("recurso_liberado_em")
  /// FINANCEIRO (detectado) ou GESTAO (informado à mão).
  recursoFonte        String?   @map("recurso_fonte")
  /// Projeto do Planejamento (MAX Financeiro): pelo PRONAC, ou escolhido pela gestão nas outras leis.
  financeiroProjectId String?   @map("financeiro_project_id")
  /// Vínculo escolhido pela gestão (não é refeito pelo PRONAC).
  financeiroManual    Boolean   @default(false) @map("financeiro_manual")
  /// Cópia da pré-definição (tarefa_modelos ativos) feita quando o projeto entrou
  /// no acompanhamento: mudanças na pré-definição só valem para projetos novos.
  modelos             Json?
  modelosEm           DateTime? @map("modelos_em")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("acompanhamentos")
}

/// Cada realização de uma ação (ex.: "Oficina 2 · 09/11" em Januária/MG).
model AcaoAgenda {
  id        String   @id @default(cuid())
  acaoId    String   @map("acao_id")
  acao      Acao     @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  titulo    String   @default("")
  /// Território cadastrado na ação (zona, cidade, UF). Nulo quando online.
  territorioId String?         @map("territorio_id")
  territorio   AcaoTerritorio? @relation(fields: [territorioId], references: [id], onDelete: SetNull)
  /// Execução online (sem território; não gera tarefas por cidade).
  online    Boolean  @default(false)
  /// Cópia da cidade/UF do território (o mapa e as tarefas por cidade usam só estes).
  cidade    String
  uf        String
  /// Início da execução desta realização.
  data      DateTime
  /// Fim da execução; nulo = um dia só (fim = início).
  dataFim   DateTime? @map("data_fim")
  tarefas   Tarefa[]
  ficha     PrestacaoFicha?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([acaoId, data])
  @@index([cidade, uf])
  @@index([territorioId])
  @@map("acao_agendas")
}

/// Tarefa de um projeto (cópia de um modelo ou avulsa).
model Tarefa {
  id             String         @id @default(cuid())
  projetoId      String         @map("projeto_id")
  projeto        Projeto        @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  modeloId       String?        @map("modelo_id")
  modelo         TarefaModelo?  @relation(fields: [modeloId], references: [id], onDelete: SetNull)
  area           AreaTarefa
  nivel          Int
  fase           FaseTarefa
  titulo         String
  detalhamento   String         @default("")
  unidade        UnidadeTarefa
  /// Nível 2 por ação: a ação e, se houver, a realização (data).
  acaoId         String?        @map("acao_id")
  acao           Acao?          @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  agendaId       String?        @map("agenda_id")
  agenda         AcaoAgenda?    @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  /// Nível 2 por cidade (produção).
  cidade         String?
  uf             String?
  status         StatusTarefa   @default(NAO_INICIADA)
  prazo          DateTime?
  /// Prazo definido à mão: a sincronização com o modelo não o recalcula.
  prazoManual    Boolean        @default(false) @map("prazo_manual")
  responsavelId  String?        @map("responsavel_id")
  concluidaEm    DateTime?      @map("concluida_em")
  atualizadoPor  String?        @map("atualizado_por")
  ordem          Int            @default(0)
  comentarios    TarefaComentario[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([projetoId, area, nivel])
  @@index([acaoId])
  @@index([agendaId])
  @@index([modeloId])
  @@map("tarefas")
}

/// Observação numa tarefa; `escalada` leva o assunto ao painel da gestão.
model TarefaComentario {
  id          String    @id @default(cuid())
  tarefaId    String    @map("tarefa_id")
  tarefa      Tarefa    @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  autorId     String    @map("autor_id")
  texto       String
  escalada    Boolean   @default(false)
  resolvidaEm DateTime? @map("resolvida_em")
  createdAt   DateTime  @default(now())

  @@index([tarefaId])
  @@map("tarefa_comentarios")
}

/// Problema que afeta a execução (ex.: hotel sem faturamento).
model Ocorrencia {
  id          String            @id @default(cuid())
  projetoId   String            @map("projeto_id")
  projeto     Projeto           @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  area        AreaTarefa
  acaoId      String?           @map("acao_id")
  cidade      String?
  uf          String?
  impacto     ImpactoOcorrencia @default(MEDIO)
  descricao   String
  decidirAte  DateTime?         @map("decidir_ate")
  status      StatusOcorrencia  @default(ABERTA)
  autorId     String            @map("autor_id")
  resolvidaEm DateTime?         @map("resolvida_em")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([projetoId, status])
  @@map("ocorrencias")
}

// ── Prestação de contas ────────────────────────────────────────────────────

enum EquipePrestacao {
  PRODUCAO
  COMUNICACAO
  GESTAO
}

enum TipoCampoPrestacao {
  TEXTO
  TEXTO_LONGO
  NUMERO
  DATA
  LINK
  OPCOES
  SIM_NAO
  /// Várias opções marcáveis.
  MULTIPLA
  /// Horário de início e fim (HH:MM-HH:MM).
  HORARIO
  /// Vários nomes (texto livre; usuários do sistema aparecem como opção).
  PESSOAS
  /// Local: nome, CEP, logradouro, número, complemento, bairro, cidade e UF.
  ENDERECO
}

/// Dados do projeto para a prestação de contas (gestão).
model PrestacaoProjeto {
  id            String    @id @default(cuid())
  projetoId     String    @unique @map("projeto_id")
  projeto       Projeto   @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  /// FEDERAL | ESTADUAL | MUNICIPAL | EDITAL | RECURSOS_PROPRIOS | OUTRA
  lei           String?
  /// PRONAC, LEIC CA ou outra identificação do projeto na lei.
  identificacao String    @default("")
  patrocinador  String    @default("")
  /// Prestação de contas entregue (conta o prazo de arquivamento dos arquivos).
  entregueEm    DateTime? @map("entregue_em")
  entreguePor   String?   @map("entregue_por")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("prestacao_projetos")
}

/// Produto prometido no projeto, com a sua meta (gestão; pode mudar ao longo do processo).
model PrestacaoProduto {
  id        String           @id @default(cuid())
  projetoId String           @map("projeto_id")
  projeto   Projeto          @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  nome      String
  meta      String           @default("")
  /// Ações do projeto que contam para este produto (cada ação em um produto só).
  acaoIds   String[]         @default([]) @map("acao_ids")
  ordem     Int              @default(0)
  fichas    PrestacaoFicha[]
  relatorios PrestacaoRelatorio[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([projetoId, ordem])
  @@map("prestacao_produtos")
}

/// Campo do modelo da ficha (Configurações). A equipe responsável preenche.
model PrestacaoCampo {
  id          String             @id @default(cuid())
  /// Identificador estável do campo nos valores das fichas e na exportação.
  chave       String             @unique
  rotulo      String
  ajuda       String             @default("")
  tipo        TipoCampoPrestacao
  opcoes      String[]           @default([])
  equipe      EquipePrestacao
  /// Sugestão automática (STATUS_DATA, SIM, PARTICIPANTES, CARGA_HORARIA, RESPONSAVEIS, HISTORICO, PERFIL).
  sugestao    String?
  obrigatorio Boolean            @default(false)
  ordem       Int                @default(0)
  ativo       Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([equipe, ordem])
  @@map("prestacao_campos")
}

/// Ficha de uma execução da ação (item da agenda).
model PrestacaoFicha {
  id            String            @id @default(cuid())
  agendaId      String            @unique @map("agenda_id")
  agenda        AcaoAgenda        @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  projetoId     String            @map("projeto_id")
  projeto       Projeto           @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  produtoId     String?           @map("produto_id")
  produto       PrestacaoProduto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  /// { [chave]: { v: valor, na?: true } } — "na" = não se aplica.
  valores       Json              @default("{}")
  /// Correções dos dados que vêm do sistema: { [chave]: valor }.
  ajustes       Json              @default("{}")
  arquivos      PrestacaoArquivo[]
  atualizadoPor String?           @map("atualizado_por")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([projetoId])
  @@map("prestacao_fichas")
}

/// Foto ou documento de uma ficha. Guardado no Storage (e, depois, no drive).
model PrestacaoArquivo {
  id          String         @id @default(cuid())
  fichaId     String         @map("ficha_id")
  ficha       PrestacaoFicha @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  projetoId   String         @map("projeto_id")
  /// FOTO ou DOCUMENTO
  tipo        String
  /// Onde entra no relatório (comprovacao, acessibilidade, divulgacao…).
  categoria   String
  /// Legenda no relatório.
  descricao   String         @default("")
  ordem       Int            @default(0)
  noRelatorio Boolean        @default(true) @map("no_relatorio")
  /// sb://bucket/chave (Supabase) ou local://chave (testes).
  storagePath String         @map("storage_path")
  nomeOriginal String        @default("") @map("nome_original")
  mime        String
  tamanho     Int
  largura     Int?
  altura      Int?
  /// Cópia no drive (etapa E).
  driveFileId String?        @map("drive_file_id")
  enviadoPor  String?        @map("enviado_por")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([fichaId, categoria, ordem])
  @@index([projetoId])
  @@map("prestacao_arquivos")
}

/// Relatório em PDF gerado pelo sistema (histórico).
model PrestacaoRelatorio {
  id          String            @id @default(cuid())
  projetoId   String            @map("projeto_id")
  projeto     Projeto           @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  /// Nulo = todos os produtos.
  produtoId   String?           @map("produto_id")
  produto     PrestacaoProduto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  /// Modelo do relatório (ex.: PRESTACAO_POR_PRODUTO).
  modelo      String
  titulo      String
  storagePath String            @map("storage_path")
  tamanho     Int
  paginas     Int?
  driveFileId String?           @map("drive_file_id")
  geradoPor   String?           @map("gerado_por")
  createdAt   DateTime          @default(now())

  @@index([projetoId, createdAt])
  @@map("prestacao_relatorios")
}

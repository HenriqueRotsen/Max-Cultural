{
  "name": "max-cultural",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:cultural": "npm run dev -w max-cultural-app",
    "dev:origem": "npm run dev -w max-origem",
    "dev:fluxo": "npm run dev -w max-fluxo",
    "lint": "npm run lint -w max-cultural-app --if-present && npm run lint -w max-origem --if-present && npm run lint -w max-fluxo --if-present",
    "audit": "node scripts/ci-audit-gate.mjs"
  },
  "overrides": {
    "sharp": "0.35.4",
    "postcss": "8.5.26",
    "deepmerge-ts": "8.0.2"
  }
}
